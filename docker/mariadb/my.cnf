# =================================================================
# MariaDB 11.7 Config — Ujian Terpadu
# Optimized for 4 core / 16GB RAM / 7000+ concurrent users
# Container memory limit: 2048M
# Memory budget: 1G buffer + 96M log + 64M tmp + ~300M overhead = ~1460M
# =================================================================

[mysqld]
# --- Character set ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- InnoDB tuning (fit within 2048M container) ---
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 4
innodb_log_file_size = 96M
innodb_log_buffer_size = 32M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_use_native_aio = OFF
innodb_adaptive_hash_index = ON

# --- Connection tuning ---
# 4 app replicas × 12 workers + 8 queue workers + admin = ~60 active connections
# Set 250 to handle burst with 7000 concurrent users
max_connections = 250
wait_timeout = 120
interactive_timeout = 120
connect_timeout = 10
thread_cache_size = 64
thread_pool_size = 4

# --- Table & temp tables ---
tmp_table_size = 64M
max_heap_table_size = 64M
table_open_cache = 4000
table_definition_cache = 2000

# --- Sort / join buffers (per-connection, keep small to avoid OOM) ---
sort_buffer_size = 1M
join_buffer_size = 1M
read_buffer_size = 512K
read_rnd_buffer_size = 1M

# --- Query execution ---
max_allowed_packet = 64M
group_concat_max_len = 1048576

# --- Slow query log ---
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# --- Binary log (disabled for single-server) ---
skip-log-bin

# --- Performance Schema (disable to save memory) ---
performance_schema = OFF

[client]
default-character-set = utf8mb4
