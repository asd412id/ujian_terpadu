# =================================================================
# MariaDB 11.7 Config — Ujian Terpadu
# Optimized for 8 core / 32GB RAM / 7000+ concurrent users
# Container memory limit: 4096M
# Memory budget: 2.5G buffer + 128M log + 128M tmp + ~500M overhead = ~3300M
# =================================================================

[mysqld]
# --- Character set ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- InnoDB tuning (fit within 4096M container) ---
innodb_buffer_pool_size = 2560M
innodb_buffer_pool_instances = 8
innodb_log_file_size = 128M
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 16
innodb_write_io_threads = 16
innodb_use_native_aio = OFF
innodb_adaptive_hash_index = ON

# --- Connection tuning ---
# 8 app replicas × 16 workers + 16 queue workers + admin = ~144 active connections
# Set 500 to handle burst with 7000 concurrent users
max_connections = 500
wait_timeout = 120
interactive_timeout = 120
connect_timeout = 10
thread_cache_size = 128
thread_pool_size = 8

# --- Table & temp tables ---
tmp_table_size = 128M
max_heap_table_size = 128M
table_open_cache = 8000
table_definition_cache = 4000

# --- Sort / join buffers (per-connection, keep small to avoid OOM) ---
sort_buffer_size = 2M
join_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 2M

# --- Query execution ---
max_allowed_packet = 64M
group_concat_max_len = 1048576

# --- Slow query log ---
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# --- Binary log (disabled for single-server) ---
skip-log-bin

# --- Performance Schema (disable to save memory) ---
performance_schema = OFF

[client]
default-character-set = utf8mb4
