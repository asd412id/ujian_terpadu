APP_NAME="Ujian Terpadu"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# DB_HOST=mariadb  (Docker service name)
# DB_PORT=3306
# DB_DATABASE=ujian_terpadu
# DB_USERNAME=ujian_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Set to true in production with HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Docker Production ---
# DB_ROOT_PASSWORD=
# DB_PASSWORD=
# REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPS_EMAIL_DOMAIN=sekolah.local

# --- Admin Account (for initial seeding) ---
ADMIN_NAME="Administrator Dinas"
ADMIN_EMAIL=admin@dinas.test
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# --- Cloudflare Tunnel (production) ---
# CLOUDFLARE_TUNNEL_TOKEN=
# TRUSTED_PROXIES defaults to Docker + Cloudflare CIDR ranges in bootstrap/app.php.
# Override only if your proxy infrastructure differs. NEVER use '*'.
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,104.16.0.0/13,104.24.0.0/14,108.162.192.0/18,131.0.72.0/22,141.101.64.0/18,162.158.0.0/15,172.64.0.0/13,188.114.96.0/20,190.93.240.0/20,197.234.240.0/22,198.41.128.0/17

# --- Anti-Cheat ---
# UJIAN_MAX_VIOLATIONS=3

# --- Horizontal Scaling ---
# Workers per app container (3 replicas × 8 = 24 total workers)
OCTANE_WORKERS=8
# Number of app replicas (adjust based on available resources)
APP_REPLICAS=3
